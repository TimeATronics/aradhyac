<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tower — A color sorting game</title>
    <meta name="description" content="A color-sorting tower puzzle built with three.js." />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <div id="tower" style="position: relative; width: 100%; height: 100vh; background: #000; touch-action: none">
      <div style="position: absolute; left: 12px; bottom: 12px; z-index: 10000; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; pointer-events: none">
        <div style="padding: 6px 10px; border-radius: 8px; background: rgba(0,0,0,0.36); color: #fff; min-width: 110px; text-align: left; pointer-events: none">
          <div style="font-size: 13px; opacity: 0.85">Score</div>
          <div id="tower-score" style="font-size: 18px; font-weight: 700">0</div>
        </div>
        <div id="tower-msg" style="padding: 6px 10px; border-radius: 8px; background: rgba(0,0,0,0.36); color: #fff; pointer-events: none" hidden></div>
        <div id="tower-done" style="padding: 6px 10px; border-radius: 8px; background: rgba(102,187,106,0.85); color: #042; font-weight: 700; pointer-events: none" hidden>Good Job!</div>
      </div>
      <div style="position: absolute; right: 12px; bottom: 12px; z-index: 10000; display: flex; gap: 8px; flex-direction: column">
        <button id="tower-reset" type="button" style="padding: 6px 8px; border-radius: 6px; background: #7a2b2b; color: #fff; border: 1px solid rgba(255,255,255,0.06); cursor: pointer; font-size: 13px">Reset</button>
        <button id="tower-hint" type="button" style="padding: 6px 8px; border-radius: 6px; background: #2b3a4a; color: #fff; border: 1px solid rgba(255,255,255,0.06); cursor: pointer; font-size: 13px">Hints</button>
      </div>
    </div>
    <script>
      import { initGame } from '../scripts/tower.ts';
      initGame(document.getElementById('tower'));
    </script>
  </body>
</html>
