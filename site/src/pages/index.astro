---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';
import resources from '../data/resources.json';
import publications from '../data/publications.cache.json';
import experience from '../data/experience.json';
import music from '../data/music.json';
import projects from '../data/projects.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const blogData = posts.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  pubDate: p.data.pubDate.toISOString(),
  description: p.data.description,
}));

const PAGE_SIZE = 5;
const json = (d: unknown) => JSON.stringify(d).replace(/</g, '\\u003c');
const pager = (id: string, n: number) => `
  <div class="projects-meta">
    <span id="${id}-meta">Showing 1-${Math.min(PAGE_SIZE, n)} of ${n}</span>
    <div class="projects-pager">
      <button id="${id}-prev" type="button" class="page-btn" disabled>&#9664; Prev</button>
      <span id="${id}-page">1 / ${Math.max(1, Math.ceil(n / PAGE_SIZE))}</span>
      <button id="${id}-next" type="button" class="page-btn">Next &#9654;</button>
    </div>
  </div>`;
---

<Base title="aradhyac">
  <section id="about">
    <h1>{profile.name}</h1>
    {profile.about.map((p) => <p>{p}</p>)}
    <div class="about-links">
      {Object.entries(profile.links).map(([label, url]) => <a href={url}>{label}</a>)}
    </div>
  </section>

  <section id="blogs">
    <div class="section-head">
      <h2>Blogs</h2>
      <a class="project-live" href="/blog">All posts</a>
    </div>
    <ul class="post-list" id="blogs-list">
      {blogData.slice(0, PAGE_SIZE).map((p) => (
        <li>
          <a class="post-title" href={`/blog/${p.slug}/`}>{p.title}</a>
          <div class="post-date">{new Date(p.pubDate).toLocaleDateString()}</div>
          {p.description && <p>{p.description}</p>}
        </li>
      ))}
    </ul>
    <div set:html={pager('blogs', blogData.length)}></div>
    <script type="application/json" id="blogs-data" set:html={json(blogData)}></script>
  </section>

  <section id="projects">
    <div class="section-head">
      <h2>Projects</h2>
    </div>
    <ul class="project-list" id="projects-list">
      {projects.slice(0, PAGE_SIZE).map((p) => (
        <li>
          <div>
            {p.repo
              ? <a class="post-title" href={p.repo} target="_blank" rel="noopener noreferrer">{p.title}</a>
              : <span class="post-title">{p.title}</span>}
            {p.link && (
              <a
                class="project-live"
                href={p.link}
                target={p.link.startsWith('http') ? '_blank' : undefined}
                rel={p.link.startsWith('http') ? 'noopener noreferrer' : undefined}
              >Live</a>
            )}
          </div>
          {p.description && <p class="project-desc">{p.description}</p>}
        </li>
      ))}
    </ul>
    <div set:html={pager('projects', projects.length)}></div>
    <script type="application/json" id="projects-data" set:html={json(projects)}></script>
  </section>

  <section id="resources">
    <div class="section-head">
      <h2>Resources</h2>
    </div>
    <table>
      <thead>
        <tr><th>Subject</th><th>Course</th><th>Institution</th><th>Link</th></tr>
      </thead>
      <tbody id="resources-list">
        {resources.slice(0, PAGE_SIZE).map((r) => (
          <tr>
            <td>{r.subject}</td>
            <td>{r.course_number}</td>
            <td>{r.institution}</td>
            <td><a href={r.url}>notes</a></td>
          </tr>
        ))}
      </tbody>
    </table>
    <div set:html={pager('resources', resources.length)}></div>
    <script type="application/json" id="resources-data" set:html={json(resources)}></script>
  </section>

  <section id="publications">
    <div class="section-head">
      <h2>Publications</h2>
      <button id="pub-refresh" type="button" class="icon-btn" title="Refresh from ORCID" aria-label="Refresh from ORCID">&#10227;</button>
    </div>
    <table>
      <thead>
        <tr><th>Title</th><th>Venue</th><th>Year</th><th>Link</th></tr>
      </thead>
      <tbody id="publications-list">
        {publications.slice(0, PAGE_SIZE).map((p) => (
          <tr>
            <td>{p.title}</td>
            <td>{p.venue}</td>
            <td>{p.year}</td>
            <td><a href={p.url ?? `https://doi.org/${p.doi}`}>doi</a></td>
          </tr>
        ))}
      </tbody>
    </table>
    <div set:html={pager('publications', publications.length)}></div>
    <script type="application/json" id="publications-data" set:html={json(publications)}></script>
  </section>

  <section id="experience">
    <div class="section-head">
      <h2>Experience</h2>
    </div>
    <div id="experience-list">
      {experience.slice(0, PAGE_SIZE).map((e) => (
        <div class="experience-item">
          <h3>{e.position} - <span class="experience-org">{e.organization}</span></h3>
          <div class="post-date">{e.period}</div>
          <ul>
            {e.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <div set:html={pager('experience', experience.length)}></div>
    <script type="application/json" id="experience-data" set:html={json(experience)}></script>
  </section>

  {music.length > 0 && (
    <section id="music">
      <div class="section-head">
        <h2>Music</h2>
      </div>
      <div id="music-list">
        {music.slice(0, PAGE_SIZE).map((m) => (
          <div class="music-item">
            <iframe
              style="border: 0; width: 100%; height: 42px;"
              src={m.url}
              seamless
              loading="lazy"
              title={m.title}
            ></iframe>
          </div>
        ))}
      </div>
      <div set:html={pager('music', music.length)}></div>
      <script type="application/json" id="music-data" set:html={json(music)}></script>
    </section>
  )}

  <section id="contact">
    <div class="section-head">
      <h2>Contact</h2>
    </div>
    <p>Reach me at <a href="mailto:aradhya.chakrabarti@gmail.com">aradhya.chakrabarti@gmail.com</a></p>
  </section>

  <script>
    import '../scripts/index-pagers.ts';
  </script>
  <script is:inline>
    if (location.search.includes('edit')) {
      const skip = ['publications', 'contact'];
      document.querySelectorAll('main section').forEach((s) => {
        if (skip.includes(s.id)) return;
        const btn = document.createElement('a');
        btn.className = 'edit-icon';
        btn.href = '/edit#' + s.id;
        btn.title = 'Edit ' + s.id;
        btn.textContent = '\u270E';
        const head = s.querySelector('.section-head') ?? s.querySelector('h1');
        (head ?? s).append(btn);
      });
      const exit = document.createElement('a');
      exit.className = 'edit-exit';
      exit.href = '/';
      exit.textContent = 'Exit edit mode';
      document.querySelector('nav')?.append(exit);
    }
  </script>
</Base>
