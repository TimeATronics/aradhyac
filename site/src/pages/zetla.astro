---
import { FEATURES, ALL_FEATURES, FAQS, GITHUB_BASE, THEMES } from '../data/zetla';
import '../styles/zetla.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Zetla - Local-first AI chat for Android</title>
    <meta name="description" content="AI-powered Android app with text and voice chat, web search and code execution tool calling. Your keys, your data." />
    <link rel="icon" href="/zetla/zetla-icon.svg" />
  </head>
  <body>
    <div class="zetla-page">
      <nav class="zetla-nav">
        <span class="zetla-nav-brand">Zetla</span>
        <div class="zetla-nav-links">
          <a href={GITHUB_BASE} target="_blank" rel="noopener noreferrer">Source</a>
          <a href="#zetla-download">Download</a>
          <a href={`${GITHUB_BASE}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">License</a>
          <a href="/" target="_blank" rel="noopener noreferrer">Blog</a>
        </div>
      </nav>

      <section class="zetla-hero">
        <div class="zetla-hero-inner">
          <div class="zetla-hero-text">
            <h1 class="zetla-hero-title">Zetla knows what<br />actually matters.</h1>
            <p class="zetla-hero-subtitle">
              AI-powered Android app with text and voice chat, web search and code execution tool calling. Your keys, your data.
            </p>
          </div>
          <div class="zetla-hero-visual">
            <div class="zetla-phone-card">
              <img class="zetla-hero-video" src="/zetla/hero-clip.gif" alt="Zetla demo" />

              <div class="zetla-pin zetla-pin-ribbon" data-pin>
                <svg viewBox="0 0 130 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 4h114l-16 20L118 44H4L20 24 4 4z" fill="#6C63FF"/>
                  <text x="61" y="28" text-anchor="middle" fill="#fff" fontSize="13" font-weight="700" font-family="Georgia,serif" letter-spacing="0.5">LLM Chat</text>
                </svg>
              </div>

              <div class="zetla-pin zetla-pin-newspaper" data-pin>
                <svg viewBox="0 0 180 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="1" y="1" width="178" height="70" rx="2" fill="#f5f0e8" stroke="#222" stroke-width="1.5"/>
                  <rect x="10" y="14" width="160" height="6" fill="#222"/>
                  <rect x="10" y="26" width="70" height="3" rx="1" fill="#999"/>
                  <rect x="10" y="33" width="160" height="2" rx="1" fill="#ccc"/>
                  <rect x="10" y="39" width="160" height="2" rx="1" fill="#ccc"/>
                  <rect x="10" y="45" width="120" height="2" rx="1" fill="#ccc"/>
                  <rect x="130" y="26" width="40" height="30" rx="2" fill="#e0d8c8"/>
                  <text x="90" y="11" text-anchor="middle" fill="#222" fontSize="6" font-weight="700" font-family="Georgia,serif" letter-spacing="1.5">THE DAILY ZETLA</text>
                  <text x="45" y="30" text-anchor="middle" fill="#222" fontSize="7" font-weight="700" font-family="Georgia,serif">WEB</text>
                  <text x="150" y="30" text-anchor="middle" fill="#222" fontSize="7" font-weight="700" font-family="Georgia,serif">SEARCH</text>
                </svg>
                <div class="zetla-tack"><div class="zetla-tack-head"/><div class="zetla-tack-shadow"/></div>
              </div>

              <div class="zetla-pin zetla-pin-sticker" data-pin>
                <svg viewBox="0 0 110 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="55" cy="55" r="52" fill="#FFD600" stroke="#222" stroke-width="2.5"/>
                  <circle cx="55" cy="55" r="44" fill="none" stroke="#222" stroke-width="1" stroke-dasharray="4 3"/>
                  <text x="55" y="50" text-anchor="middle" fill="#222" fontSize="10" font-weight="900" font-family="Impact,sans-serif" letter-spacing="1">OPEN</text>
                  <text x="55" y="66" text-anchor="middle" fill="#222" fontSize="10" font-weight="900" font-family="Impact,sans-serif" letter-spacing="1">SOURCE</text>
                </svg>
              </div>

              <div class="zetla-pin zetla-pin-ticket" data-pin>
                <svg viewBox="0 0 150 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="1" y="1" width="148" height="54" rx="6" fill="#7c3aed"/>
                  <circle cx="12" cy="28" r="6" fill="#fafaf7"/>
                  <circle cx="138" cy="28" r="6" fill="#fafaf7"/>
                  <line x1="24" y1="1" x2="24" y2="55" stroke="#fafaf7" stroke-width="1" stroke-dasharray="3 3" opacity="0.4"/>
                  <text x="86" y="22" text-anchor="middle" fill="#fff" fontSize="8" font-weight="700" font-family="-apple-system,sans-serif" letter-spacing="2">Bring Your</text>
                  <text x="86" y="40" text-anchor="middle" fill="rgba(255,255,255,0.7)" fontSize="16" font-weight="300" font-family="Georgia,serif" letter-spacing="1">Own Key</text>
                </svg>
              </div>

              <div class="zetla-pin zetla-pin-badge" data-pin>
                <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="50,2 61,36 98,36 68,58 79,92 50,72 21,92 32,58 2,36 39,36" fill="#ff4d6a"/>
                  <polygon points="50,14 58,36 82,36 63,50 70,74 50,60 30,74 37,50 18,36 42,36" fill="#ff6b82"/>
                  <text x="50" y="48" text-anchor="middle" fill="#fff" fontSize="7" font-weight="800" font-family="Georgia,serif" letter-spacing="0.5">VOICE</text>
                  <text x="50" y="60" text-anchor="middle" fill="#fff" fontSize="7" font-weight="800" font-family="Georgia,serif">CHAT</text>
                </svg>
                <div class="zetla-tack"><div class="zetla-tack-head"/><div class="zetla-tack-shadow"/></div>
              </div>

              <div class="zetla-pin zetla-pin-handwritten" data-pin>
                <svg viewBox="0 0 130 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="2" y="2" width="126" height="42" rx="6" fill="#fff" stroke="#222" stroke-width="1.5"/>
                  <line x1="2" y1="24" x2="128" y2="24" stroke="#e44" stroke-width="1" stroke-dasharray="0"/>
                  <text x="65" y="21" text-anchor="middle" fill="#222" fontSize="14" font-family="Georgia,serif" fontStyle="italic">your phone,</text>
                  <text x="65" y="37" text-anchor="middle" fill="#222" fontSize="14" font-family="Georgia,serif" fontStyle="italic">your data.</text>
                </svg>
                <div class="zetla-tack"><div class="zetla-tack-head"/><div class="zetla-tack-shadow"/></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {FEATURES.map((feat, i) => (
        <section
          class={`zetla-feature-bg ${i % 2 === 1 ? 'is-flipped' : ''}${feat.carousel ? ' zetla-carousel-section' : ''}`}
          style={{ background: feat.bg }}
        >
          <div class={`zetla-feature-section ${i % 2 === 1 ? 'is-flipped' : ''}`}>
            <div class="zetla-feature-text">
              <span class="zetla-feature-eyebrow">{`0${i + 1}`}</span>
              <h2 class="zetla-feature-title">{feat.title}</h2>
              <p class="zetla-feat-desc">{feat.desc}</p>
              <p class="zetla-feat-detail">{feat.detail}</p>
            </div>
            <div class={`zetla-feature-img${feat.carousel ? ' zetla-feature-img-carousel' : ''}`}>
              <div class="zetla-feature-img-inner">
                {feat.carousel ? (
                  <div class="zetla-carousel-stack">
                    <img id="zetla-carousel-front" src={THEMES[0].image} alt="" draggable={false} class="zetla-carousel-stack-img" />
                    <img id="zetla-carousel-back" src={THEMES[0].image} alt="" draggable={false} class="zetla-carousel-stack-img" />
                  </div>
                ) : (
                  <img src={feat.image} alt={feat.title} draggable={false} />
                )}
              </div>
              {feat.carousel && (
                <div class="zetla-carousel-controls">
                  <button type="button" class="zetla-carousel-btn" id="zetla-carousel-prev" aria-label="Previous theme">&#9664;</button>
                  <div class="zetla-carousel-dots">
                    {THEMES.map((_, j) => (
                      <span class={`zetla-carousel-dot ${j === 0 ? 'is-active' : ''}`} />
                    ))}
                  </div>
                  <button type="button" class="zetla-carousel-btn" id="zetla-carousel-next" aria-label="Next theme">&#9654;</button>
                </div>
              )}
            </div>
          </div>
        </section>
      ))}

      <section class="zetla-table-bg">
        <div class="zetla-table-section">
          <h2 class="zetla-section-title">Everything you need.</h2>
          <p class="zetla-section-subtitle">A complete AI toolkit that fits in your pocket.</p>
          <div class="zetla-table">
            {ALL_FEATURES.map((f) => (
              <div class="zetla-table-row">
                <span class="zetla-table-name">{f.name}</span>
                <span class="zetla-table-detail">{f.detail}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="zetla-cta" id="zetla-download">
        <div class="zetla-cta-logo zetla-cta-el"><img src={`/zetla/zetla-icon.svg`} alt="Zetla" /></div>
        <h2 class="zetla-cta-title zetla-cta-el">Get Zetla now.</h2>
        <p class="zetla-cta-subtitle zetla-cta-el">Open source. Free. Download the APK that fits your device.</p>
        <div class="zetla-cta-buttons zetla-cta-el">
          <a href={`${GITHUB_BASE}/releases/download/v0.1.0-alpha/app-arm64-v8a-release.apk`} target="_blank" rel="noopener noreferrer" class="zetla-btn zetla-btn-primary">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8 .198a8 8 0 00-2.53 15.59c.4.074.546-.174.546-.388 0-.192-.007-.70-.01-1.37-2.22.484-2.69-1.07-2.69-1.07-.363-.923-.887-1.17-.887-1.17-.726-.497.055-.487.055-.487.803.056 1.225.825 1.225.825.714 1.223 1.872.87 2.33.666.072-.517.28-.87.51-1.07-1.77-.2-3.63-.885-3.63-3.943 0-.872.312-1.586.824-2.146-.083-.202-.357-1.015.078-2.116 0 0 .672-.215 2.2.82a7.6 7.6 0 012.004-.27c.68.003 1.366.092 2.004.27 1.527-1.035 2.198-.82 2.198-.82.437 1.101.163 1.914.08 2.116.513.56.823 1.274.823 2.146 0 3.07-1.864 3.74-3.64 3.936.288.248.543.736.543 1.484 0 1.072-.01 1.936-.01 2.2 0 .216.144.466.55.387A8.001 8.001 0 008 .198z" />
            </svg>
            arm64-v8a
          </a>
          <a href={`${GITHUB_BASE}/releases/download/v0.1.0-alpha/app-armeabi-v7a-release.apk`} target="_blank" rel="noopener noreferrer" class="zetla-btn zetla-btn-secondary">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8 .198a8 8 0 00-2.53 15.59c.4.074.546-.174.546-.388 0-.192-.007-.70-.01-1.37-2.22.484-2.69-1.07-2.69-1.07-.363-.923-.887-1.17-.887-1.17-.726-.497.055-.487.055-.487.803.056 1.225.825 1.225.825.714 1.223 1.872.87 2.33.666.072-.517.28-.87.51-1.07-1.77-.2-3.63-.885-3.63-3.943 0-.872.312-1.586.824-2.146-.083-.202-.357-1.015.078-2.116 0 0 .672-.215 2.2.82a7.6 7.6 0 012.004-.27c.68.003 1.366.092 2.004.27 1.527-1.035 2.198-.82 2.198-.82.437 1.101.163 1.914.08 2.116.513.56.823 1.274.823 2.146 0 3.07-1.864 3.74-3.64 3.936.288.248.543.736.543 1.484 0 1.072-.01 1.936-.01 2.2 0 .216.144.466.55.387A8.001 8.001 0 008 .198z" />
            </svg>
            armeabi-v7a
          </a>
        </div>
      </section>

      <section class="zetla-faq-bg">
        <div class="zetla-faq-section">
          <h2 class="zetla-section-title">Frequently asked questions.</h2>
          <div class="zetla-faq-list">
            {FAQS.map((faq) => (
              <div class="zetla-faq-item">
                <button class="zetla-faq-q" type="button">
                  <span>{faq.q}</span>
                  <span class="zetla-faq-chevron">&rsaquo;</span>
                </button>
                <div class="zetla-faq-a-wrap"><div class="zetla-faq-a">{faq.a}</div></div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <footer class="zetla-footer">
        <span>&copy; 2026 Aradhya Chakrabarti</span>
        <span class="zetla-footer-sep">&middot;</span>
        <a href="/" target="_blank" rel="noopener noreferrer">aradhyac.com</a>
      </footer>
    </div>

    <script>
      import '../scripts/zetla.ts';
    </script>
  </body>
</html>
